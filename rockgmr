#!/bin/bash

VERSION="4.0"

# ---------- Colors ----------
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RESET='\033[0m'
BOLD='\033[1m'

banner() {
    clear
    echo -e "${RED}"
    echo "██████╗  ██████╗  ██████╗██╗  ██╗     ██████╗ ███╗   ███╗██████╗ "
    echo "██╔══██╗██╔═══██╗██╔════╝██║ ██╔╝    ██╔════╝ ████╗ ████║██╔══██╗"
    echo "██████╔╝██║   ██║██║     █████╔╝     ██║  ███╗██╔████╔██║██████╔╝"
    echo "██╔══██╗██║   ██║██║     ██╔═██╗     ██║   ██║██║╚██╔╝██║██╔══██╗"
    echo "██║  ██║╚██████╔╝╚██████╗██║  ██╗    ╚██████╔╝██║ ╚═╝ ██║██║  ██║"
    echo "╚═╝  ╚═╝ ╚═════╝  ╚═════╝╚═╝  ╚═╝     ╚═════╝ ╚═╝     ╚═╝╚═╝  ╚═╝"
    echo -e "${RESET}"
    echo -e "${CYAN}        Rock GMR - Network Reconnaissance Framework${RESET}"
    echo -e "${YELLOW}        Version: $VERSION${RESET}"
    echo
}

help_menu() {
    echo -e "${BOLD}Usage:${RESET}"
    echo "  ./rockgmr [option] <target>"
    echo
    echo -e "${CYAN}Modules:${RESET}"
    echo "  -d, --dns       DNS information"
    echo "  -p, --ports     TCP port scan"
    echo "  -i, --ip        IP information"
    echo "  -w, --web       HTTP/HTTPS information"
    echo "  -t, --tls       TLS information"
    echo "  -a, --all       Run all safe checks"
    echo
    echo -e "${CYAN}General:${RESET}"
    echo "  -h, --help      Show help"
    echo "  -v, --version   Show version"
    echo
    echo -e "${YELLOW}Examples:${RESET}"
    echo "  ./rockgmr -d google.com"
    echo "  ./rockgmr -p 192.168.1.1"
    echo "  ./rockgmr -a example.com"
}

module_start() {
    echo
    echo -e "${BLUE}========================================${RESET}"
    echo -e "${CYAN}[*] Module: $1${RESET}"
    echo -e "${BLUE}========================================${RESET}"
}

run_dns() {
    module_start "DNS"
    echo "[+] Target: $1"
    echo
    echo "[+] A records:"
    dig +short "$1" A
    echo
    echo "[+] AAAA records:"
    dig +short "$1" AAAA
    echo
    echo "[+] MX records:"
    dig +short "$1" MX
    echo
    echo "[+] NS records:"
    dig +short "$1" NS
}

run_ip() {
    module_start "IP INFORMATION"

    IP=$(dig +short "$1" A | head -1)

    if [ -z "$IP" ]; then
        echo -e "${RED}[-] Could not resolve IPv4 address${RESET}"
        return
    fi

    echo "[+] Domain : $1"
    echo "[+] IPv4   : $IP"

    echo
    echo "[+] Reverse DNS:"
    dig +short -x "$IP"
}

run_ports() {
    module_start "PORT SCANNER"

    echo "[+] Target: $1"
    echo "[+] Port scanning module loaded"
    echo
    echo -e "${YELLOW}[!] Port scanning is intended for systems you own or are authorized to test.${RESET}"
}

run_web() {
    module_start "WEB"

    echo "[+] Target: $1"
    echo

    echo "[+] HTTP:"
    curl -sI --max-time 5 "http://$1" | head -10

    echo
    echo "[+] HTTPS:"
    curl -sI --max-time 5 "https://$1" | head -10
}

run_tls() {
    module_start "TLS"

    echo "[+] Target: $1:443"
    echo

    echo | openssl s_client \
        -connect "$1:443" \
        -servername "$1" \
        2>/dev/null |
        openssl x509 -noout -subject -issuer -dates
}

# ---------- Arguments ----------

if [ "$1" = "-v" ] || [ "$1" = "--version" ]; then
    echo "Rock GMR v$VERSION"
    exit 0
fi

if [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ -z "$1" ]; then
    banner
    help_menu
    exit 0
fi

MODE="$1"
TARGET="$2"

if [ -z "$TARGET" ]; then
    banner
    echo -e "${RED}[-] Target is required.${RESET}"
    echo
    help_menu
    exit 1
fi

banner

echo -e "${GREEN}[+] Target: $TARGET${RESET}"
echo -e "${GREEN}[+] Starting Rock GMR...${RESET}"

case "$MODE" in

    -d|--dns)
        run_dns "$TARGET"
        ;;

    -p|--ports)
        run_ports "$TARGET"
        ;;

    -i|--ip)
        run_ip "$TARGET"
        ;;

    -w|--web)
        run_web "$TARGET"
        ;;

    -t|--tls)
        run_tls "$TARGET"
        ;;

    -a|--all)
        run_dns "$TARGET"
        run_ip "$TARGET"
        run_web "$TARGET"
        run_tls "$TARGET"
        run_ports "$TARGET"
        ;;

    *)
        echo -e "${RED}[-] Unknown option: $MODE${RESET}"
        echo
        help_menu
        exit 1
        ;;
esac

echo
echo -e "${GREEN}========================================${RESET}"
echo -e "${GREEN}[+] Rock GMR scan completed${RESET}"
echo -e "${GREEN}========================================${RESET}"
