#!/usr/bin/env bash

# ============================================================
# ROCK GMR V6.1
# Authorized Bug-Bounty Recon & Non-Destructive Web Auditor
# ============================================================

VERSION="6.1"
TARGET=""
MODE=""
PORTS="80,443"
OUTPUT=""
JSON_OUTPUT=""
TIMEOUT=8
MAX_URLS=100

TMP_DIR="$(mktemp -d /tmp/rockgmr.XXXXXX)"
REPORT="$TMP_DIR/report.txt"
DISCOVERED="$TMP_DIR/discovered.txt"
JSFILES="$TMP_DIR/jsfiles.txt"

cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

# ------------------------------------------------------------
# Colors
# ------------------------------------------------------------

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
RESET='\033[0m'

# ------------------------------------------------------------
# Banner
# ------------------------------------------------------------

banner() {
    echo -e "${CYAN}"
    echo "██████╗  ██████╗  ██████╗██╗  ██╗     ██████╗ ███╗   ███╗██████╗"
    echo "██╔══██╗██╔═══██╗██╔════╝██║ ██╔╝    ██╔════╝ ████╗ ████║██╔══██╗"
    echo "██████╔╝██║   ██║██║     █████╔╝     ██║  ███╗██╔████╔██║██████╔╝"
    echo "██╔══██╗██║   ██║██║     ██╔═██╗     ██║   ██║██║╚██╔╝██║██╔══██╗"
    echo "██║  ██║╚██████╔╝╚██████╗██║  ██╗    ╚██████╔╝██║ ╚═╝ ██║██████╔╝"
    echo "╚═╝  ╚═╝ ╚═════╝  ╚═════╝╚═╝  ╚═╝     ╚═════╝ ╚═╝     ╚═╝╚═════╝"
    echo -e "${RESET}"
    echo "       Rock GMR V${VERSION}"
    echo "       Authorized Bug-Bounty Recon & Web Auditor"
    echo
}

# ------------------------------------------------------------
# Usage
# ------------------------------------------------------------

usage() {
cat <<EOF

Usage:
  $0 [OPTION] TARGET

Modes:

  -d, --dns          DNS reconnaissance
  -i, --ip           IP / reverse DNS
  -w, --web          HTTP/HTTPS audit
  -t, --tls          TLS certificate audit
  -r, --rdap         RDAP lookup
  -H, --headers      Security-header audit
  -C, --cors         CORS observation
  -c, --cookies      Cookie security audit
  -R, --resources    robots/sitemap/security.txt
  -e, --endpoints    Public endpoint discovery
  -j, --js           Public JavaScript discovery
  -f, --files        Public resource checks
  -T, --tech         Technology indicators

  -a, --all          Complete passive/non-destructive audit

Port audit:

  -p, --ports        Authorized private/lab port audit
  -P, --ports-list   Example: 22,80,443

Reporting:

  -o, --output FILE  TXT report
  -J, --json FILE    JSON report

Other:

  --timeout SEC      Network timeout
  -v, --version      Version
  -h, --help         Help

Examples:

  $0 -a example.com

  $0 -d example.com

  $0 -w example.com

  $0 -e example.com

  $0 -J report.json example.com

Authorized private/lab port audit:

  $0 -p 192.168.1.10 -P 22,80,443

EOF
}

# ------------------------------------------------------------
# Dependency check
# ------------------------------------------------------------

check_dependencies() {

    local missing=()

    for cmd in dig curl openssl python3; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if [ "${#missing[@]}" -gt 0 ]; then
        echo -e "${RED}[!] Missing:${RESET} ${missing[*]}"
        echo
        echo "Install with:"
        echo
        echo "apt install dnsutils curl openssl python3"
        exit 1
    fi
}

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

log() {
    echo -e "$1" | tee -a "$REPORT"
}

plain_log() {
    echo "$1" >> "$REPORT"
}

# ------------------------------------------------------------
# URL helper
# ------------------------------------------------------------

normalize_target() {

    TARGET="${TARGET#http://}"
    TARGET="${TARGET#https://}"
    TARGET="${TARGET%%/*}"

}

# ------------------------------------------------------------
# DNS
# ------------------------------------------------------------

run_dns() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} DNS RECONNAISSANCE${RESET}"
    log "${BLUE}================================================${RESET}"

    for type in A AAAA CNAME MX NS TXT; do

        log "${YELLOW}[$type]${RESET}"

        result=$(dig +short "$TARGET" "$type" 2>/dev/null)

        if [ -n "$result" ]; then
            while IFS= read -r line; do
                log "  $line"
            done <<< "$result"
        else
            log "  No record found"
        fi

        echo

    done
}

# ------------------------------------------------------------
# IP
# ------------------------------------------------------------

run_ip() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} IP / REVERSE DNS${RESET}"
    log "${BLUE}================================================${RESET}"

    ips=$(dig +short "$TARGET" A 2>/dev/null)

    if [ -z "$ips" ]; then
        log "${YELLOW}[!] No IPv4 address found.${RESET}"
        return
    fi

    while IFS= read -r ip; do

        [ -z "$ip" ] && continue

        log "${GREEN}IPv4:${RESET} $ip"

        reverse=$(dig +short -x "$ip" 2>/dev/null)

        if [ -n "$reverse" ]; then
            log "Reverse DNS: $reverse"
        else
            log "Reverse DNS: none"
        fi

        echo

    done <<< "$ips"
}

# ------------------------------------------------------------
# Web
# ------------------------------------------------------------

run_web() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} HTTP / HTTPS AUDIT${RESET}"
    log "${BLUE}================================================${RESET}"

    for scheme in http https; do

        url="${scheme}://${TARGET}"
        headers="$TMP_DIR/${scheme}.headers"

        log "${YELLOW}[$scheme]${RESET} $url"

        curl -k -I -L \
            --connect-timeout "$TIMEOUT" \
            --max-time "$TIMEOUT" \
            -sS "$url" > "$headers" 2>/dev/null

        if [ ! -s "$headers" ]; then
            log "  No response"
            echo
            continue
        fi

        grep -m1 '^HTTP/' "$headers" |
            tr -d '\r' |
            tee -a "$REPORT"

        for h in server content-type location x-powered-by; do

            value=$(grep -i -m1 "^${h}:" "$headers" |
                tr -d '\r')

            [ -n "$value" ] && log "  $value"

        done

        echo

    done
}

# ------------------------------------------------------------
# Security Headers
# ------------------------------------------------------------

run_headers() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} SECURITY HEADERS${RESET}"
    log "${BLUE}================================================${RESET}"

    headers="$TMP_DIR/security.headers"

    curl -k -I \
        --connect-timeout "$TIMEOUT" \
        --max-time "$TIMEOUT" \
        -sS "https://${TARGET}" > "$headers" 2>/dev/null

    if [ ! -s "$headers" ]; then
        log "${YELLOW}[!] HTTPS unavailable.${RESET}"
        return
    fi

    declare -A checks

    checks["strict-transport-security"]="HSTS"
    checks["content-security-policy"]="CSP"
    checks["x-content-type-options"]="X-Content-Type-Options"
    checks["x-frame-options"]="X-Frame-Options"
    checks["referrer-policy"]="Referrer-Policy"
    checks["permissions-policy"]="Permissions-Policy"

    for key in "${!checks[@]}"; do

        name="${checks[$key]}"

        value=$(grep -i -m1 "^${key}:" "$headers" |
            tr -d '\r')

        if [ -n "$value" ]; then
            log "${GREEN}[FOUND]${RESET} $value"
        else
            log "${YELLOW}[MISSING]${RESET} $name"
        fi

    done
}

# ------------------------------------------------------------
# Cookies
# ------------------------------------------------------------

run_cookies() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} COOKIE SECURITY AUDIT${RESET}"
    log "${BLUE}================================================${RESET}"

    headers="$TMP_DIR/cookies.headers"

    curl -k -I \
        --connect-timeout "$TIMEOUT" \
        --max-time "$TIMEOUT" \
        -sS "https://${TARGET}" > "$headers" 2>/dev/null

    cookies=$(grep -i '^set-cookie:' "$headers" 2>/dev/null)

    if [ -z "$cookies" ]; then
        log "No Set-Cookie header observed."
        return
    fi

    while IFS= read -r cookie; do

        log "$cookie"

        lower=$(echo "$cookie" | tr '[:upper:]' '[:lower:]')

        [[ "$lower" == *"; secure"* ]] ||
            log "  ${YELLOW}[!] Secure flag not observed${RESET}"

        [[ "$lower" == *"; httponly"* ]] ||
            log "  ${YELLOW}[!] HttpOnly flag not observed${RESET}"

        [[ "$lower" == *"samesite="* ]] ||
            log "  ${YELLOW}[!] SameSite not observed${RESET}"

        echo

    done <<< "$cookies"
}

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

run_cors() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} CORS OBSERVATION${RESET}"
    log "${BLUE}================================================${RESET}"

    headers="$TMP_DIR/cors.headers"

    curl -k -I \
        --connect-timeout "$TIMEOUT" \
        --max-time "$TIMEOUT" \
        -sS "https://${TARGET}" > "$headers" 2>/dev/null

    grep -iE \
        '^(access-control-allow-origin|access-control-allow-credentials|access-control-allow-methods|access-control-allow-headers):' \
        "$headers" |
        tr -d '\r' |
        tee -a "$REPORT"

    if ! grep -qi '^access-control-' "$headers"; then
        log "No CORS response headers observed."
    fi
}

# ------------------------------------------------------------
# TLS
# ------------------------------------------------------------

run_tls() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} TLS CERTIFICATE AUDIT${RESET}"
    log "${BLUE}================================================${RESET}"

    cert="$TMP_DIR/cert.pem"

    timeout "$TIMEOUT" \
        openssl s_client \
        -connect "${TARGET}:443" \
        -servername "$TARGET" \
        </dev/null 2>/dev/null |
        openssl x509 -out "$cert" 2>/dev/null

    if [ ! -s "$cert" ]; then
        log "${YELLOW}[!] Certificate unavailable.${RESET}"
        return
    fi

    openssl x509 -in "$cert" -noout \
        -subject \
        -issuer \
        -dates \
        -serial |
        tee -a "$REPORT"

    log "${YELLOW}[Subject Alternative Names]${RESET}"

    openssl x509 -in "$cert" \
        -noout -ext subjectAltName 2>/dev/null |
        tee -a "$REPORT"

    log "${YELLOW}[TLS Connection]${RESET}"

    timeout "$TIMEOUT" \
        openssl s_client \
        -connect "${TARGET}:443" \
        -servername "$TARGET" \
        </dev/null 2>&1 |
        grep -E 'Protocol|Cipher' |
        tee -a "$REPORT"
}

# ------------------------------------------------------------
# Public Resources
# ------------------------------------------------------------

run_resources() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} PUBLIC RESOURCES${RESET}"
    log "${BLUE}================================================${RESET}"

    resources=(
        "/robots.txt"
        "/sitemap.xml"
        "/.well-known/security.txt"
        "/security.txt"
        "/humans.txt"
        "/manifest.json"
    )

    for path in "${resources[@]}"; do

        code=$(curl -k -L -o /dev/null \
            -s -w "%{http_code}" \
            --connect-timeout "$TIMEOUT" \
            --max-time "$TIMEOUT" \
            "https://${TARGET}${path}" 2>/dev/null)

        case "$code" in
            200)
                log "${GREEN}[200]${RESET} $path"
                ;;
            301|302|307|308)
                log "${YELLOW}[$code]${RESET} $path"
                ;;
            *)
                log "[${code}] $path"
                ;;
        esac

    done
}

# ------------------------------------------------------------
# HTML + Public Endpoint Discovery
# ------------------------------------------------------------

run_endpoints() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} PUBLIC ENDPOINT DISCOVERY${RESET}"
    log "${BLUE}================================================${RESET}"

    body="$TMP_DIR/index.html"

    curl -k -L \
        --connect-timeout "$TIMEOUT" \
        --max-time "$TIMEOUT" \
        -sS "https://${TARGET}" \
        -o "$body" 2>/dev/null

    if [ ! -s "$body" ]; then
        log "${YELLOW}[!] Could not retrieve HTML.${RESET}"
        return
    fi

    : > "$DISCOVERED"

    grep -Eo \
        '(href|src|action)=["'\''][^"'\'']+["'\'']' \
        "$body" 2>/dev/null |
        sed -E 's/^[^=]+=["'\'']//; s/["'\'']$//' |
        sort -u |
        head -n "$MAX_URLS" > "$DISCOVERED"

    if [ ! -s "$DISCOVERED" ]; then
        log "No public references found."
        return
    fi

    while IFS= read -r url; do

        [ -z "$url" ] && continue

        case "$url" in
            http://*|https://*)
                log "  $url"
                ;;
            /*)
                log "  https://${TARGET}${url}"
                ;;
            *)
                log "  $url"
                ;;
        esac

    done < "$DISCOVERED"
}

# ------------------------------------------------------------
# JavaScript Discovery
# ------------------------------------------------------------

run_js() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} PUBLIC JAVASCRIPT DISCOVERY${RESET}"
    log "${BLUE}================================================${RESET}"

    body="$TMP_DIR/js.html"

    curl -k -L \
        --connect-timeout "$TIMEOUT" \
        --max-time "$TIMEOUT" \
        -sS "https://${TARGET}" \
        -o "$body" 2>/dev/null

    if [ ! -s "$body" ]; then
        log "HTML unavailable."
        return
    fi

    : > "$JSFILES"

    grep -Eo \
        '<script[^>]+src=["'\''][^"'\'']+["'\'']' \
        "$body" 2>/dev/null |
        sed -E 's/.*src=["'\'']//; s/["'\''].*$//' |
        sort -u |
        head -n "$MAX_URLS" > "$JSFILES"

    if [ ! -s "$JSFILES" ]; then
        log "No external JavaScript files found."
        return
    fi

    while IFS= read -r js; do

        case "$js" in
            http://*|https://*)
                log "  $js"
                ;;
            /*)
                log "  https://${TARGET}${js}"
                ;;
            *)
                log "  https://${TARGET}/${js}"
                ;;
        esac

    done < "$JSFILES"
}

# ------------------------------------------------------------
# Technology Indicators
# ------------------------------------------------------------

run_technology() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} TECHNOLOGY INDICATORS${RESET}"
    log "${BLUE}================================================${RESET}"

    headers="$TMP_DIR/technology.headers"

    curl -k -L -I \
        --connect-timeout "$TIMEOUT" \
        --max-time "$TIMEOUT" \
        -sS "https://${TARGET}" > "$headers" 2>/dev/null

    grep -iE \
        '^(server|x-powered-by|via|x-generator|x-drupal-cache):' \
        "$headers" |
        tr -d '\r' |
        tee -a "$REPORT"

    body="$TMP_DIR/technology.html"

    curl -k -L \
        --connect-timeout "$TIMEOUT" \
        --max-time "$TIMEOUT" \
        -sS "https://${TARGET}" \
        -o "$body" 2>/dev/null

    [ ! -s "$body" ] && return

    grep -qi "wp-content" "$body" &&
        log "Possible WordPress indicator"

    grep -qi "Drupal.settings" "$body" &&
        log "Possible Drupal indicator"

    grep -qi "__NEXT_DATA__" "$body" &&
        log "Possible Next.js indicator"

    grep -qi "next/static" "$body" &&
        log "Possible Next.js indicator"

    grep -qi "ng-version" "$body" &&
        log "Possible Angular indicator"
}

# ------------------------------------------------------------
# Public File Checks
# ------------------------------------------------------------

run_files() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} PUBLIC FILE CHECK${RESET}"
    log "${BLUE}================================================${RESET}"

    files=(
        "/robots.txt"
        "/sitemap.xml"
        "/.well-known/security.txt"
        "/security.txt"
        "/manifest.json"
        "/favicon.ico"
    )

    for path in "${files[@]}"; do

        response=$(curl -k -L \
            --connect-timeout "$TIMEOUT" \
            --max-time "$TIMEOUT" \
            -s -o /dev/null \
            -w "%{http_code} %{content_type}" \
            "https://${TARGET}${path}" 2>/dev/null)

        log "$path -> $response"

    done
}

# ------------------------------------------------------------
# RDAP
# ------------------------------------------------------------

run_rdap() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} RDAP INFORMATION${RESET}"
    log "${BLUE}================================================${RESET}"

    ip=$(dig +short "$TARGET" A 2>/dev/null | head -n1)

    if [ -z "$ip" ]; then
        log "${YELLOW}[!] No IPv4 found.${RESET}"
        return
    fi

    response="$TMP_DIR/rdap.json"

    curl -L -sS \
        --connect-timeout "$TIMEOUT" \
        --max-time "$TIMEOUT" \
        "https://rdap.org/ip/${ip}" \
        -o "$response" 2>/dev/null

    if [ ! -s "$response" ]; then
        log "${YELLOW}[!] RDAP failed.${RESET}"
        return
    fi

    python3 - "$response" <<'PY' | tee -a "$REPORT"
import json
import sys

try:
    with open(sys.argv[1], errors="replace") as f:
        d = json.load(f)

    for key in [
        "handle",
        "name",
        "country",
        "startAddress",
        "endAddress"
    ]:
        value = d.get(key)
        if value is not None:
            print(f"{key}: {value}")

except Exception as e:
    print("RDAP JSON parsing failed:", e)
PY
}

# ------------------------------------------------------------
# Private/Lab Port Audit
# ------------------------------------------------------------

is_private_ipv4() {

    local ip="$1"

    [[ "$ip" =~ ^10\. ]] && return 0
    [[ "$ip" =~ ^127\. ]] && return 0
    [[ "$ip" =~ ^192\.168\. ]] && return 0
    [[ "$ip" =~ ^172\.(1[6-9]|2[0-9]|3[0-1])\. ]] && return 0

    return 1
}

run_ports() {

    log "${BLUE}================================================${RESET}"
    log "${BLUE} AUTHORIZED PRIVATE/LAB PORT AUDIT${RESET}"
    log "${BLUE}================================================${RESET}"

    ip="$TARGET"

    if [[ ! "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        ip=$(dig +short "$TARGET" A 2>/dev/null | head -n1)
    fi

    if [ -z "$ip" ]; then
        log "${RED}[!] IPv4 target unavailable.${RESET}"
        return
    fi

    if ! is_private_ipv4 "$ip"; then
        log "${YELLOW}[!] Port audit is limited to private/local IPv4 targets.${RESET}"
        log "    Example: 192.168.1.10"
        return
    fi

    IFS=',' read -ra port_array <<< "$PORTS"

    for port in "${port_array[@]}"; do

        if [[ ! "$port" =~ ^[0-9]+$ ]] ||
           [ "$port" -lt 1 ] ||
           [ "$port" -gt 65535 ]; then
            log "${YELLOW}[!] Invalid port: $port${RESET}"
            continue
        fi

        if command -v nc >/dev/null 2>&1; then

            if nc -z -w 2 "$ip" "$port" >/dev/null 2>&1; then
                log "${GREEN}[OPEN]${RESET} $port"
            else
                log "${RED}[CLOSED/FILTERED]${RESET} $port"
            fi

        else

            if timeout 2 bash -c "</dev/tcp/$ip/$port" \
                >/dev/null 2>&1; then
                log "${GREEN}[OPEN]${RESET} $port"
            else
                log "${RED}[CLOSED/FILTERED]${RESET} $port"
            fi

        fi

    done
}

# ------------------------------------------------------------
# JSON Report
# ------------------------------------------------------------

make_json() {

    [ -z "$JSON_OUTPUT" ] && return

    python3 - "$REPORT" "$JSON_OUTPUT" "$TARGET" "$VERSION" <<'PY'

import json
import sys
from datetime import datetime, timezone

report_file = sys.argv[1]
output_file = sys.argv[2]
target = sys.argv[3]
version = sys.argv[4]

with open(report_file, "r", errors="replace") as f:
    report = f.read()

data = {
    "tool": "Rock GMR",
    "version": version,
    "target": target,
    "timestamp_utc": datetime.now(timezone.utc).isoformat(),
    "type": "authorized_non_destructive_recon",
    "report": report
}

with open(output_file, "w") as f:
    json.dump(data, f, indent=2)

print(f"[+] JSON report saved: {output_file}")

PY
}

# ------------------------------------------------------------
# Argument Parsing
# ------------------------------------------------------------

while [[ $# -gt 0 ]]; do

    case "$1" in

        -d|--dns)
            MODE="dns"
            shift
            ;;

        -i|--ip)
            MODE="ip"
            shift
            ;;

        -w|--web)
            MODE="web"
            shift
            ;;

        -t|--tls)
            MODE="tls"
            shift
            ;;

        -r|--rdap)
            MODE="rdap"
            shift
            ;;

        -H|--headers)
            MODE="headers"
            shift
            ;;

        -C|--cors)
            MODE="cors"
            shift
            ;;

        -c|--cookies)
            MODE="cookies"
            shift
            ;;

        -R|--resources)
            MODE="resources"
            shift
            ;;

        -e|--endpoints)
            MODE="endpoints"
            shift
            ;;

        -j|--js)
            MODE="js"
            shift
            ;;

        -f|--files)
            MODE="files"
            shift
            ;;

        -T|--tech)
            MODE="tech"
            shift
            ;;

        -p|--ports)
            MODE="ports"
            shift
            ;;

        -a|--all)
            MODE="all"
            shift
            ;;

        -P|--ports-list)
            PORTS="$2"
            shift 2
            ;;

        -o|--output)
            OUTPUT="$2"
            shift 2
            ;;

        -J|--json)
            JSON_OUTPUT="$2"
            shift 2
            ;;

        --timeout)
            TIMEOUT="$2"
            shift 2
            ;;

        -v|--version)
            echo "Rock GMR V${VERSION}"
            exit 0
            ;;

        -h|--help)
            banner
            usage
            exit 0
            ;;

        -*)
            echo "${RED}[!] Unknown option: $1${RESET}"
            usage
            exit 1
            ;;

        *)
            TARGET="$1"
            shift
            ;;

    esac

done

# ------------------------------------------------------------
# Start
# ------------------------------------------------------------

banner

if [ -z "$TARGET" ]; then
    echo "${RED}[!] Target required.${RESET}"
    usage
    exit 1
fi

if [ -z "$MODE" ]; then
    echo "${RED}[!] Select a module.${RESET}"
    usage
    exit 1
fi

normalize_target
check_dependencies

log "Target : $TARGET"
log "Mode   : $MODE"
log "Time   : $(date)"
echo

# ------------------------------------------------------------
# Execute
# ------------------------------------------------------------

case "$MODE" in

    dns)
        run_dns
        ;;

    ip)
        run_ip
        ;;

    web)
        run_web
        ;;

    tls)
        run_tls
        ;;

    rdap)
        run_rdap
        ;;

    headers)
        run_headers
        ;;

    cors)
        run_cors
        ;;

    cookies)
        run_cookies
        ;;

    resources)
        run_resources
        ;;

    endpoints)
        run_endpoints
        ;;

    js)
        run_js
        ;;

    files)
        run_files
        ;;

    tech)
        run_technology
        ;;

    ports)
        run_ports
        ;;

    all)
        run_dns
        run_ip
        run_web
        run_headers
        run_cookies
        run_cors
        run_tls
        run_resources
        run_endpoints
        run_js
        run_technology
        run_files
        run_rdap
        ;;

esac

# ------------------------------------------------------------
# Reports
# ------------------------------------------------------------

if [ -n "$OUTPUT" ]; then

    cp "$REPORT" "$OUTPUT"

    echo
    echo -e "${GREEN}[+] TXT report saved:${RESET} $OUTPUT"

fi

make_json

echo
echo -e "${GREEN}================================================${RESET}"
echo -e "${GREEN} Rock GMR V${VERSION} completed${RESET}"
echo -e "${GREEN}================================================${RESET}"
